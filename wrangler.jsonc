{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "continuity-motors",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",

  "routes": [
    {
      "pattern": "horizonco.co.in",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "continuity-motors",
      "database_id": "5987c8c8-a48a-401a-ba21-151b42878d82",
      "migrations_dir": "migrations"
    }
  ],

  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "LEAD_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}