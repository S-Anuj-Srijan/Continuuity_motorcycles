{
  "name": "continuity-motors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prepare:content": "node scripts/content.mjs",
    "prepare:assets": "node scripts/assets.mjs",
    "build": "npm run prepare:content && astro build",
    "check": "astro check && tsc --noEmit -p tsconfig.worker.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "wrangler dev",
    "deploy": "npm run build && node scripts/deploy-check.mjs && wrangler deploy",
    "db:local": "wrangler d1 migrations apply continuity-motors --local",
    "db:remote": "wrangler d1 migrations apply continuity-motors --remote"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "node": "^22.23.3",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
