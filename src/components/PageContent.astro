---
import BaseLayout from '../layouts/BaseLayout.astro';
import Asset from './Asset.astro';
import ProductCards from './ProductCards.astro';
import EarlyAccess from './EarlyAccess.astro';
import FAQ from './FAQ.astro';
import DevelopmentStatus from './DevelopmentStatus.astro';
import {pages,paragraphs,linkFor,type Page} from '../lib/content';
interface Props {page:Page}
const {page}=Astro.props;
const home=page.route==='/';
const product=page.route.match(/^\/c-01\/(camel|messerschmitt)$/)?.[1];
const hero=page.hero;
const article=page.isArticle;
const sectionId=(key:string)=>({'FORM':'form','ENGINEERING':'engineering','DETAIL':'details','EVERY ANGLE':'views-board','CONTEXT':'poster','STATUS':'status'}[key]||key.toLowerCase().replaceAll(' ','-'));
const articles=pages.filter(p=>p.isArticle);
const imageFor=(key:string,index:number)=>{
  if(product)return key==='FORM'?`${product}_hero_side`:key==='ENGINEERING'?`${product}_engineering_board`:key==='EVERY ANGLE'?`${product}_views_board`:key==='CONTEXT'?`${product}_poster_hangar`:null;
  if(page.route==='/engineering')return index===0?'camel_engineering_board':key==='STATUS'?'messerschmitt_engineering_board':null;
  if(page.route==='/design')return key==='HISTORIC AVIATION'?'messerschmitt_poster_hangar':key==='MECHANICAL WATCHES'?'camel_views_board':null;
  if(page.route==='/development')return index===0?'camel_views_board':null;
  return null;
};
---
<BaseLayout title={page.title} description={page.description} route={page.route} product={product?`c01_${product}`:''} article={article} image={product?`/assets/products/c01/${product}/continuity-c01-${product}-${product==='camel'?'electric-roadster':'electric-cafe-racer'}-side-profile.webp`:undefined}>
  <section class:list={['hero', { 'home-hero':home, 'product-hero':!!product, 'editorial-hero':!home&&!product }]} data-section="hero">
    {home && <div class="hero-art" aria-hidden="true">{['camel','messerschmitt'].map(v=><template data-hero-variant={v}><Asset id={`${v}_poster_hangar`} eager interactive={false} caption={false} /></template>)}<noscript><Asset id="camel_poster_hangar" eager interactive={false} caption={false} /></noscript></div>}
    <div class="hero-content wrap"><p class="eyebrow">{hero.Eyebrow || (article?'CONTINUITY JOURNAL':'CONTINUITY MOTORS')}</p><h1>{hero.H1}</h1>{hero.Descriptor&&<p class="descriptor">{hero.Descriptor}</p>}
    {(!home||!product)&&<div class="hero-body">{paragraphs(hero.Body).map(p=><p>{p}</p>)}</div>}
    {(hero['Primary CTA']||hero.CTAs)&&<div class="actions">{(hero.CTAs?hero.CTAs.split('\n'):[hero['Primary CTA'],hero['Secondary CTA']]).filter(Boolean).map((text,i)=><a class:list={['button',{secondary:i>0}]} data-track="cta_click" href={linkFor(text!)}>{text}<span aria-hidden="true">↗</span></a>)}</div>}
    {article&&<p class="article-byline">By Continuity Motors · Design & engineering</p>}
    </div>
    {product&&<Asset id={`${product}_hero_side`} eager interactive={false} caption={false} />}
    {(home||product)&&<div class="hero-baseline wrap"><span><i></i> DIGITAL CONCEPT / IN DEVELOPMENT</span><a href="/development">Explore the current status ↗</a></div>}
  </section>
  {page.route==='/development'&&<DevelopmentStatus />}
  {page.isLegal&&<div class="legal-note wrap"><p>Draft policy — final legal review and business details are pending before public launch.</p></div>}
  {page.sections.map((s,index)=>{
    const asset=imageFor(s.key,index);
    const cards=(home&&s.key==='C-01 FAMILY')||(page.route==='/c-01'&&s.key==='ONE IDEA, TWO EXPRESSIONS')||(page.route==='/design'&&s.key==='TWO CHARACTERS')||(page.route==='/about'&&s.key==='C-01');
    const alternate=product&&s.key.startsWith('RELATIONSHIP');
    return <section class:list={['editorial-section',{ 'has-art':!!asset,'family-section':cards,'status-section':s.key.includes('STATUS')||s.key==='DEVELOPMENT','thesis':home&&index===0 }]} id={sectionId(s.key)} data-section={sectionId(s.key)}>
      <div class="section-copy wrap"><div><p class="eyebrow"><span class="section-number">{String(index+1).padStart(2,'0')}</span> {s.Eyebrow||s.key}</p><h2>{s.Heading}</h2></div><div class="prose">{paragraphs(s.Body).map(p=><p>{p}</p>)}{s.Camel&&<p>{s.Camel}</p>}{s.Messerschmitt&&<p>{s.Messerschmitt}</p>}{s.CTA&&!cards&&<a class="text-link" href={linkFor(s.CTA)} data-track={alternate?'variant_switch':'cta_click'} data-destination={alternate?`c01_${product==='camel'?'messerschmitt':'camel'}`:undefined}>{s.CTA}<span aria-hidden="true">↗</span></a>}</div></div>
      {asset&&<div class="wrap"><Asset id={asset} />{s.key==='CONTEXT'&&<button class="link-button share-button" data-share>Share this direction ↗</button>}</div>}
      {cards&&<div class="wrap"><ProductCards /></div>}
      {alternate&&<div class="switcher wrap"><Asset id={`${product==='camel'?'messerschmitt':'camel'}_hero_side`} interactive={false}/></div>}
      {home&&s.key==='ENGINEERING'&&<div class="wrap" data-assigned-art>{['camel','messerschmitt'].map(v=><template data-board-variant={v}><Asset id={`${v}_engineering_board`} /></template>)}<noscript><Asset id="camel_engineering_board" /></noscript></div>}
    </section>;
  })}
  {article&&<article class="article-body wrap">{page.article.map(block=>block.type==='h2'?<h2>{block.text}</h2>:<p>{block.text}</p>)}<aside class="article-status">The C-01 is currently in digital development. <a href="/development">See current C-01 development status.</a></aside></article>}
  {page.isLegal&&<div class="article-body wrap">{page.legal.map(block=><section>{block.heading&&<h2>{block.heading}</h2>}{paragraphs(block.body).map(p=><p>{p}</p>)}</section>)}</div>}
  {page.route==='/journal'&&<section class="journal-grid wrap" aria-label="Journal articles">{articles.map((a,i)=><a class="journal-card" href={a.route}><Asset id={['camel_hero_side','messerschmitt_hero_side','camel_views_board','messerschmitt_engineering_board','camel_engineering_board'][i]} interactive={false} caption={false}/><p class="eyebrow">{i>2?'ENGINEERING':'DESIGN'} / JOURNAL 0{i+1}</p><h2>{a.hero.H1}</h2><p>{a.description}</p><span class="text-link">Read the article ↗</span></a>)}</section>}
  <EarlyAccess />
  <FAQ items={page.faq} />
  <section class="related wrap"><p class="eyebrow">CONTINUE EXPLORING</p><div>{(article?articles.filter(p=>p.route!==page.route).slice(0,2):pages.filter(p=>['/engineering','/design','/development'].includes(p.route)&&p.route!==page.route).slice(0,2)).map(p=><a href={p.route}>{p.hero.H1} <span aria-hidden="true">↗</span></a>)}</div></section>
</BaseLayout>
